{
  "name": "tallyd",
  "version": "0.1.0",
  "description": "Double-entry ledger and bank-reconciliation engine",
  "type": "module",
  "license": "MIT",
  "author": "Daniyal",
  "keywords": [
    "accounting",
    "double-entry",
    "ledger",
    "bookkeeping",
    "reconciliation",
    "bank-statement",
    "trial-balance",
    "typescript"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/DaniyalMlk/tallyd.git"
  },
  "bugs": {
    "url": "https://github.com/DaniyalMlk/tallyd/issues"
  },
  "homepage": "https://github.com/DaniyalMlk/tallyd#readme",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "bin": {
    "tallyd": "dist/cli/main.js"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=20.19.0"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "prepack": "npm run build",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "demo": "vite-node src/demo/main.ts",
    "demo:ingest": "vite-node src/demo/mainIngest.ts",
    "demo:reconcile": "vite-node src/demo/mainReconcile.ts",
    "demo:reports": "vite-node src/demo/mainStatements.ts",
    "demo:foreign": "vite-node src/demo/mainForeign.ts",
    "demo:group": "vite-node src/demo/mainGroup.ts",
    "demo:periods": "vite-node src/demo/mainGroupPeriods.ts",
    "demo:midyear": "vite-node src/demo/mainMidYear.ts",
    "demo:disposal": "vite-node src/demo/mainDisposal.ts",
    "demo:evidence": "vite-node src/demo/mainEvidence.ts",
    "cli": "vite-node src/cli/main.ts --",
    "bench": "vite-node src/cli/main.ts -- bench",
    "generate": "vite-node src/cli/main.ts -- generate",
    "docs": "vite-node docs/build-site.ts"
  },
  "devDependencies": {
    "@types/node": "^22.10.2",
    "fast-check": "^3.23.2",
    "typescript": "^5.7.2",
    "vitest": "^2.1.8"
  }
}
