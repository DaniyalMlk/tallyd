{
  "name": "tallyd",
  "version": "0.1.0",
  "description": "Double-entry ledger and bank-reconciliation engine",
  "type": "module",
  "license": "MIT",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "demo": "vite-node src/demo/main.ts",
    "demo:ingest": "vite-node src/demo/mainIngest.ts",
    "demo:reconcile": "vite-node src/demo/mainReconcile.ts",
    "demo:reports": "vite-node src/demo/mainStatements.ts",
    "demo:foreign": "vite-node src/demo/mainForeign.ts",
    "cli": "vite-node src/cli/main.ts --",
    "bench": "vite-node src/cli/main.ts -- bench",
    "generate": "vite-node src/cli/main.ts -- generate"
  },
  "devDependencies": {
    "@types/node": "^22.10.2",
    "fast-check": "^3.23.2",
    "typescript": "^5.7.2",
    "vitest": "^2.1.8"
  },
  "bin": {
    "tallyd": "dist/src/cli/main.js"
  }
}
